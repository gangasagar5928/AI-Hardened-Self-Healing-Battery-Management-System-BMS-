    <COMPANY>GCET EEE Department</COMPANY>
    <REVISION>v1.0</REVISION>
  </SCHEMATIC_PROPERTIES>
  <CIRCUIT_ELEMENTS>
    <MODULE TYPE="ESP32-WROOM-32" ID="U1" POSITION="100,100" NET_TX="CAN_TX" NET_RX="CAN_RX" NET_SDA="I2C_SDA" NET_SCL="I2C_SCL"/>
    <MODULE TYPE="BQ76920" ID="U2" POSITION="300,100" NET_ALERT="ALERT" NET_SDA="I2C_SDA" NET_SCL="I2C_SCL"/>
    <MODULE TYPE="SN65HVD230" ID="U3" POSITION="500,100" NET_CANH="CAN_H" NET_CANL="CAN_L" NET_TX="CAN_TX" NET_RX="CAN_RX"/>
    <MODULE TYPE="AMS1117-3.3" ID="U4" POSITION="700,100" NET_VIN="VCC_5V" NET_VOUT="VCC_3V3"/>
    <MODULE TYPE="SSD1306_OLED" ID="U5" POSITION="100,250" NET_SDA="I2C_SDA" NET_SCL="I2C_SCL"/>
    <BATTERY_PACK TYPE="LI_ION_16S" ID="BATT1" POSITION="800,100" NOMINAL_VOLTAGE="57.6V" SUBMODULE_BENCH="14.8V"/>
    <INSTRUMENT TYPE="OSCILLOSCOPE" ID="OSC1" PROBE_A="CAN_H" PROBE_B="CAN_L" PROBE_C="N_SHUNT_OUT" PROBE_D="VCC_3V3"/>
